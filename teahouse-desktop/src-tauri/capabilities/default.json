{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enables IPC from the local teahouse server so the injected title bar can draw and drive the window.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "allow-shell-control",
    "allow-shell-action",
    "allow-shell-state",
    "allow-shell-zoom"
  ]
}
