# Runtime data. Contains data/config.json, which holds your API key, plus your
# chats, imported cards and world books. Never commit this.
/data/

# Real-world samples you drop in for extra verification. Not shipped: the
# committed corpus under /corpus/owned is generated by scripts/make-fixtures.ts.
/corpus/local/

# Defence in depth: reference checkouts must never land inside the repository,
# which is why nothing is cloned into corpus/ any more.
/corpus/_sources/
/_ref/

# Atomic-write scratch files
.*.tmp

# Node
node_modules/
npm-debug.log*
